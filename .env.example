# Copy to .env. Everything is optional: the defaults run fully offline.
AGENTPLAT_DATABASE_URL=sqlite+aiosqlite:///./agentplat.db
# AGENTPLAT_DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:55434/agent
# AGENTPLAT_REDIS_URL=redis://localhost:56381/0
AGENTPLAT_EMBEDDED_WORKER=true

# Model provider: fake (offline, default) | gemini | openai | anthropic
AGENTPLAT_PROVIDER=fake
# AGENTPLAT_MODEL=<model name from your provider>
# AGENTPLAT_GEMINI_API_KEY=
# AGENTPLAT_OPENAI_API_KEY=
# AGENTPLAT_ANTHROPIC_API_KEY=

# Dev convenience: tenant:user pairs granted admin + approvals:decide at startup
AGENTPLAT_BOOTSTRAP_ADMINS=["acme:admin"]
AGENTPLAT_OFFLINE_WEB=true
# AGENTPLAT_OTEL_ENDPOINT=http://localhost:4318/v1/traces
# AGENTPLAT_TOOL_SECRETS={"web_search": {"API_KEY": "..."}}

# Run Alembic migrations on startup (set false when migrating as a separate release step)
AGENTPLAT_AUTO_MIGRATE=true
